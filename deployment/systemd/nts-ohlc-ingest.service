[Unit]
Description=NTS daily Polygon OHLC incremental ingest
After=network.target
OnFailure=nts-alert@%n.service
# nts-alert@ is the USER-scope alert template (deployment/systemd/
# nts-alert@.service); the older telegram-alert@ is a SYSTEM unit with a
# root-only env file and unreachable from here. The script also sends its
# own Telegram alert on every failure path — nts-alert@ is the net for a
# crash before that point (broken venv, missing creds, traceback).

[Service]
Type=oneshot
WorkingDirectory=/home/trading/news-trading-system
ExecStart=/home/trading/news-trading-system/.venv/bin/python3 /home/trading/news-trading-system/scripts/ingest_ohlc.py --incremental
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
